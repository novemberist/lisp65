; Synchronous v1.4 parity toy: character cells, one classic VIC sprite,
; Q8.7 subpixel positions, frame pacing and one complete SID snapshot.

(defun %toy-move (sprite)
  (let ((x (int->q 80))
        (step (q 1 64))
        (count 0))
    (while (< count 8)
      (progn
        (m65-sprite-position sprite (q->int x) 100)
        (wait 2)
        (setq x (q+ x step))
        (setq count (+ count 1))))))

(defun main ()
  (progn
      (m65-draw-fill 1 1 30 5 32 6)
      (m65-draw-line 1 1 30 1 42 7)
      (m65-draw-line 1 5 30 5 42 7)
      (m65-sprite-shape 0
        "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX")
      (m65-sprite-color 0 2)
      (m65-sprite-position 0 80 100)
      (m65-sprite-enable 0 t)
      (%toy-move 0)
      (key-event 1)
      (m65-sid-voice 0 0 32 17 34 243 12)
      (wait 12)
      (m65-sid-voice 0 0 32 16 34 243 12)
      t))

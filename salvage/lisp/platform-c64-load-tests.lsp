; Host-Tests fuer die C64-LOAD-sichere Platform-Zeichner-Variante.

(MEM-RESET)
(DE GETKEY () 0)
(DE LOAD (NAME) (LIST 'LOAD NAME))

(DRAW-LINE 0 0 7 0 1)
(CHECK (PEEK 8192) 255)
(CHECK (PEEK 8200) 255)
(CHECK (PEEK 1024) 16)
(CHECK (PEEK 1031) 16)

(MEM-RESET)
(DEMO-DASHBOARD)
(CHECK (PEEK 53265) 59)
(CHECK (PEEK 53272) 24)
(CHECK (PEEK 8192) 255)
(CHECK (PEEK 8200) 255)
(CHECK (PEEK 8512) 255)
(CHECK (PEEK 1024) 16)
(CHECK (PEEK 1025) 16)
(CHECK (PEEK 1065) 32)
(CHECK (DEMO-HANDLE-KEY 65) T)
(CHECK (PEEK 54296) 15)
(CHECK (DEMO-HANDLE-KEY 76) '(LOAD DEMO))
(CHECK (DEMO-HANDLE-KEY 0) T)

(CHECK-REPORT)

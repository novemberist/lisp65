; C64-LOAD-sichere Platform-Zeichner.
; Gleiche oeffentliche API wie lib-platform/lib-platform-c64, aber in kurze
; SAVE-Format-Records zerlegt. PLAT-PLOT zeichnet ein sichtbares 8-Pixel-Segment
; pro logischem Punkt, damit kleine portable Demos auf dem C64 sichtbar bleiben.

(DE H (A B V) (COND ((LESSP A B) (POKE A V) (H (ADD1 A) B V))))
(DE P2 (N) (COND ((ZEROP N) 1) (T (TIMES 2 (P2 (SUB1 N))))))
(DE HB (X) (P2 (DIFFERENCE 7 (LOGAND X 7))))
(DE HA (X Y) (PLUS 8192 (PLUS (TIMES Y 320) (TIMES X 8))))
(DE HC (X Y) (PLUS 1024 (PLUS (TIMES Y 40) X)))
(DE HCB (FG BG) (LOGOR (TIMES (LOGAND FG 15) 16) (LOGAND BG 15)))

(DE PLAT-PLOT (X Y C) (PP1 (HA X Y) (HB X) (HC X Y) C))
(DE PP1 (A B CELL C) (PP2 CELL C (POKE A 255)))
(DE PP2 (CELL C R) (PP3 (POKE CELL (HCB C 0))))
(DE PP3 (R) T)
(DE PLAT-CLEAR (C) (PC1 C (POKE 53280 C)))
(DE PC1 (C R) (PC2 C (POKE 53281 C)))
(DE PC2 (C R) (PC3 C (POKE 53265 59)))
(DE PC3 (C R) (PC4 C (POKE 53272 24)))
(DE PC4 (C R) (PC5 C (BMCLEAR)))
(DE PC5 (C R) (PC6 C T))
(DE PC6 (C R) (PC7 (SCLEAR)))
(DE PC7 (R) T)
(DE CLEARBUF (C) (CB1 C (POKE 53280 C)))
(DE CB1 (C R) (CB2 C (POKE 53281 C)))
(DE CB2 (C R) (CB3 C (BMCLEAR)))
(DE CB3 (C R) (CB4 C T))
(DE CB4 (C R) (CB5 (SCLEAR)))
(DE CB5 (R) T)
(DE BMCLEAR () (BCL 0))
(DE BCL (R) (COND ((LESSP R 10) (BCL1 R (H (PLUS 8192 (TIMES R 320))
  (PLUS 8320 (TIMES R 320)) 0))) (T T)))
(DE BCL1 (R X) (BCL (ADD1 R)))
(DE SCLEAR () (SCL 0))
(DE SCL (R) (COND ((LESSP R 25) (SCL1 R (H (PLUS 1024 (TIMES R 40))
  (PLUS 1064 (TIMES R 40)) 0))) (T T)))
(DE SCL1 (R X) (SCL (ADD1 R)))
(DE SHOWHIRES () (SH1 (POKE 53265 59)))
(DE SH1 (R) (SH2 (POKE 53272 24)))
(DE SH2 (R) T)
(DE PLAT-GETKEY () (GETKEY))
(DE PLAT-TONE (V F W) (PT1 (POKE 54296 15)))
(DE PT1 (R) T)
(DE PLAT-LOAD (NAME) (LOAD NAME))

(DE PABS (N) (COND ((MINUSP N) (DIFFERENCE 0 N)) (T N)))
(DE NEG1 () (DIFFERENCE 0 1))
(DE PSIGN (N) (COND ((MINUSP N) (NEG1)) (T (PS2 N))))
(DE PS2 (N) (COND ((ZEROP N) 0) (T 1)))
(DE PBOTH (A B C D) (COND ((EQUAL A B) (EQUAL C D)) (T NIL)))
(DE READ-KEY () (PLAT-GETKEY))
(DE PLOT (X Y C) (PLAT-PLOT X Y C))
(DE CLEARSCREEN (C) (PLAT-CLEAR C))
(DE CLEAR-SCREEN (C) (CLEARSCREEN C))
(DE PLAYTONE (VOICE FREQ WAVE) (PLAT-TONE VOICE FREQ WAVE))
(DE PLAY-TONE (VOICE FREQ WAVE) (PLAYTONE VOICE FREQ WAVE))
(DE PLAYSAMPLE (VOICE FREQ WAVE) (PLAT-TONE VOICE FREQ WAVE))
(DE PLAY-SAMPLE (VOICE FREQ WAVE) (PLAYSAMPLE VOICE FREQ WAVE))
(DE LOADFILE (NAME) (PLAT-LOAD NAME))
(DE LOAD-FILE (NAME) (LOADFILE NAME))

(DE DRAWLINE (X0 Y0 X1 Y1 C)
  (DL1 X0 Y0 X1 Y1 C (PABS (DIFFERENCE X1 X0)) (PABS (DIFFERENCE Y1 Y0))))
(DE DRAW-LINE (X0 Y0 X1 Y1 C) (DRAWLINE X0 Y0 X1 Y1 C))
(DE DL1 (X0 Y0 X1 Y1 C DX DY)
  (DL2 X0 Y0 X1 Y1 C DX DY (PSIGN (DIFFERENCE X1 X0)) (PSIGN (DIFFERENCE Y1 Y0))))
(DE DL2 (X0 Y0 X1 Y1 C DX DY SX SY)
  (DLP X0 Y0 X1 Y1 C DX DY SX SY (DIFFERENCE DX DY)))
(DE DLP (X0 Y0 X1 Y1 C DX DY SX SY E)
  (DLP1 X0 Y0 X1 Y1 C DX DY SX SY E (PLOT X0 Y0 C)))
(DE DLP1 (X0 Y0 X1 Y1 C DX DY SX SY E R)
  (COND ((PBOTH X0 X1 Y0 Y1) T)
    (T (DLS X0 Y0 X1 Y1 C DX DY SX SY E (TIMES 2 E)))))
(DE UX (E E2 DY)
  (COND ((GREATERP E2 (DIFFERENCE 0 DY)) (DIFFERENCE E DY)) (T E)))
(DE UX0 (X SX E2 DY)
  (COND ((GREATERP E2 (DIFFERENCE 0 DY)) (PLUS X SX)) (T X)))
(DE UY (E E2 DX) (COND ((LESSP E2 DX) (PLUS E DX)) (T E)))
(DE UY0 (Y SY E2 DX) (COND ((LESSP E2 DX) (PLUS Y SY)) (T Y)))
(DE DLS (X0 Y0 X1 Y1 C DX DY SX SY E E2)
  (DLS1 (UX0 X0 SX E2 DY) Y0 X1 Y1 C DX DY SX SY (UX E E2 DY) E2))
(DE DLS1 (X0 Y0 X1 Y1 C DX DY SX SY E E2)
  (DLP X0 (UY0 Y0 SY E2 DX) X1 Y1 C DX DY SX SY (UY E E2 DX)))

(DE DRAWRECTANGLE (X0 Y0 X1 Y1 C)
  (DR1 X0 Y0 X1 Y1 C (DRAWLINE X0 Y0 X1 Y0 C)))
(DE DRAW-RECTANGLE (X0 Y0 X1 Y1 C) (DRAWRECTANGLE X0 Y0 X1 Y1 C))
(DE DR1 (X0 Y0 X1 Y1 C R) (DR2 X0 Y0 X1 Y1 C (DRAWLINE X0 Y1 X1 Y1 C)))
(DE DR2 (X0 Y0 X1 Y1 C R) (DR3 X0 Y0 X1 Y1 C (DRAWLINE X0 Y0 X0 Y1 C)))
(DE DR3 (X0 Y0 X1 Y1 C R) (DR4 (DRAWLINE X1 Y0 X1 Y1 C)))
(DE DR4 (R) T)
(DE FILLRECTANGLE (X0 Y0 X1 Y1 C) (FR1 X0 Y0 X1 Y1 C Y0))
(DE FILL-RECTANGLE (X0 Y0 X1 Y1 C) (FILLRECTANGLE X0 Y0 X1 Y1 C))
(DE FR1 (X0 Y0 X1 Y1 C Y)
  (FR2 X0 Y0 X1 Y1 C Y (DRAWLINE X0 Y X1 Y C)))
(DE FR2 (X0 Y0 X1 Y1 C Y R)
  (COND ((NOT (LESSP Y Y1)) T) (T (FR1 X0 Y0 X1 Y1 C (ADD1 Y)))))

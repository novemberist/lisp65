; Tests for lib-c64key-load -- explicit init contract plus token decoding.

(C64KEYINIT)

(CHECK CIA1PRA 56320)
(CHECK CIA1PRB 56321)
(CHECK (MATRIX-REF 1 6) "E")
(CHECK (MATRIX-REF 7 4) "SPACE")
(CHECK (KEY-COL-SELECT 0) 254)
(CHECK (KEY-COL-SELECT 7) 127)

(CHECK (DECODE-KEY (QUOTE (255 191 255 255 255 255 255 255))) "e")
(CHECK (DECODE-KEY (QUOTE (255 123 255 255 255 255 255 255))) "A")
(CHECK (DECODE-KEY (QUOTE (255 191 255 255 255 255 255 251))) "C-e")
(CHECK (DECODE-KEY (QUOTE (255 255 223 255 255 255 255 223))) "M-f")
(CHECK (DECODE-KEY (QUOTE (253 255 255 255 255 255 255 255))) "RET")
(CHECK (DECODE-KEY (QUOTE (255 255 255 255 255 255 255 239))) " ")
(CHECK (DECODE-KEY (QUOTE (255 255 255 255 255 255 255 251))) NIL)

(POKE CIA1PRB 191)
(CHECK (LENGTH (READ-SNAPSHOT)) 8)
(CHECK (CAR (READ-SNAPSHOT)) 191)
(CHECK (PEEK CIA1PRA) 127)

(CHECK (PETSCII->TOKEN 5) "C-e")
(CHECK (PETSCII->TOKEN 19) "C-s")
(CHECK (PETSCII->TOKEN 13) "RET")
(CHECK (PETSCII->TOKEN 20) "DEL")
(CHECK (PETSCII->TOKEN 32) " ")
(CHECK (PETSCII->TOKEN 65) "A")
(CHECK (PETSCII->TOKEN 97) "a")
(CHECK (PETSCII->TOKEN 0) NIL)

(DE GETKEY () 66)
(CHECK (GETKEY->TOKEN) "B")

(CHECK-REPORT)

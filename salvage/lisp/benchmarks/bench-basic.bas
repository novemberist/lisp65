10 REM LISP 64 BENCHMARK-VERGLEICH -- C64 BASIC V2 FASSUNG
20 REM AEQUIVALENT ZU lisp/benchmarks/bench.lsp
30 REM ZEITMESSUNG UEBER TI (JIFFIES, 1/60 S). PRO FALL TI SICHERN UND DIFF DRUCKEN.
40 REM EINZELN PER GOSUB AUFRUFBAR; HIER ALS GESAMTLAUF.
100 REM --- 1. FIB(15) (REKURSIV) ---
110 T0=TI : N=15 : GOSUB 1000 : PRINT "FIB(15)=";FR;" T=";TI-T0
200 REM --- 2. SUMTO(100) ---
210 T0=TI : S=0 : FOR I=1 TO 100 : S=S+I : NEXT : PRINT "SUMTO(100)=";S;" T=";TI-T0
300 REM --- 3. LISTSUM (ARRAY-STELLVERTRETER FUER LISTE) ---
310 T0=TI : S=0 : FOR I=1 TO 50 : S=S+I : NEXT : PRINT "LISTSUM(50)=";S;" T=";TI-T0
400 REM --- 4. COUNT-PRIMES(100) ---
410 T0=TI : C=0
420 FOR I=2 TO 100
430 P=1 : D=2
440 IF D*D>I THEN 480
450 IF I-INT(I/D)*D=0 THEN P=0 : GOTO 480
460 D=D+1 : GOTO 440
480 IF P=1 THEN C=C+1
490 NEXT : PRINT "COUNT-PRIMES(100)=";C;" T=";TI-T0
500 END
1000 REM FIB UNTERPROGRAMM (REKURSION VIA STACK-SIMULATION NICHT NOETIG: BASIC HAT KEINE
1010 REM ECHTE REKURSION -- HIER ITERATIV ZUM FAIREN INTEGER-VERGLEICH)
1020 IF N<2 THEN FR=N : RETURN
1030 A=0 : B=1
1040 FOR K=2 TO N : FC=A+B : A=B : B=FC : NEXT
1050 FR=B : RETURN

(CHECK (MVP-IDE-EVAL-RESULT (MVP-IDE-LINE-SESSION "(ADD1 9)")) 10)
(CHECK (MVP-IDE-EVAL-RESULT (MVP-IDE-LINE-SESSION "(TIMES 3 4)")) 12)
(CHECK (MVP-IDE-EVAL-RESULT (MVP-IDE-LINE-SESSION "(QUOTIENT 9 3)")) 3)
(CHECK (MVP-IDE-EVAL-RESULT (MVP-IDE-LINE-SESSION "(PLUS (TIMES 2 3) 4)")) 10)
(CHECK (MVP-IDE-EVAL-RESULT (MVP-IDE-LINE-SESSION "(TIMES (ADD1 2) (DIFFERENCE 9 5))")) 12)
(CHECK (MVP-IDE-EVAL-RESULT (MVP-IDE-LINE-SESSION "(MVPSAVED)")) 12)
(CHECK (MVP-PARSE-CMD (STR->LINE ":HELP")) (QUOTE HELP))
(CHECK (MVP-PARSE-CMD (STR->LINE " :CLEAR ")) (QUOTE CLEAR))
(CHECK (MVP-PARSE-CMD (STR->LINE ":LOAD LOADDEF")) (CONS (QUOTE LOAD) "LOADDEF"))
(CHECK (MVP-PARSE-CMD (STR->LINE ":LOAD")) NIL)
(CHECK (MVP-PARSE-CMD (STR->LINE ":LOADDEF")) NIL)
(CHECK (MVP-PARSE-CMD (STR->LINE ":LOAD LOAD DEF")) (CONS (QUOTE LOAD) "LOAD DEF"))
(CHECK (MVP-PARSE-CMD (STR->LINE ":SAVE MVPSAVE")) (CONS (QUOTE SAVE) "MVPSAVE"))
(CHECK (MVP-PARSE-CMD (STR->LINE ":SAVE")) NIL)
(DE LOAD args
  (LIST (CAR args) (CAR (CDR args))))
(DE OPEN args T)
(DE OUTPUT args T)
(DE PRINT args T)
(DE NORMAL args T)
(DE CLOSE args T)
(CHECK (MB-LINE (MVP-IDE-EVAL-CURRENT (MVP-IDE-LINE-SESSION ":HELP"))) ":CLEAR :HELP :LOAD :SAVE")
(CHECK (LINE->STR (CUR-LINE (SS-ED (MVP-IDE-EVAL-CURRENT (MVP-IDE-LINE-SESSION ":CLEAR"))))) "")
(CHECK (MB-LINE (MVP-IDE-EVAL-CURRENT (MVP-IDE-LINE-SESSION ":LOAD LOADDEF"))) "LOADED LOADDEF")

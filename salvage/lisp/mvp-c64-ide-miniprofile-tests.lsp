(CHECK (MVP-IDE-LOOP-SMOKE) 'MVPLOOPOK)
(CHECK (MVP-IDE-LOOP-RENDER-SMOKE) 'MVPRENDEROK)

(SETQ MVP-TEST-KEYS (APPEND (MVP-PLUS12-CODES) (LIST 18)))

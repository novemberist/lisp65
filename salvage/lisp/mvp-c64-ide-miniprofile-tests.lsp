(CHECK (PEEK 1025) 16)
(CHECK (PEEK 1144) 61)
(CHECK (PEEK 1145) 62)
(CHECK (PEEK 1147) 51)
(CHECK (LINE->STR (CUR-LINE (SS-ED (MVP-IDE-LOOP-SESSION)))) "(PLUS 1 2)")

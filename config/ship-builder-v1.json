      "SHIP.JSON",
      "LICENSE.TXT"
    ]
  },
  "runtime": {
    "profile": "dialect-v2-evaluator-free-ship-v1",
    "base_library": "core",
    "preload_bank": 5,
    "preload_offset": 0,
    "forbidden_symbols": [
      "compile_top_form",
      "crepl_boot_init",
      "eval",

    "library_functions": "reachable-only",
    "dependency_order": "l65p-v1-resolution-lock",
    "unknown_dynamic_target": "reject",
    "diagnostics": "forbidden",
    "probes": "forbidden",
    "compiler_and_workbench": "forbidden"

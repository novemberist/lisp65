    "entry_abi": "named-zero-argument-p0",
    "overwrite": "forbidden"
  },
  "authorities": {
    "project_parser_and_resolver": "tools/host-lisp/l65p_v1.py",
    "library_catalog": "config/ship-library-catalog-v1.json",

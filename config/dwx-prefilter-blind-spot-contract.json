{
  "format": "lisp65-dwx-prefilter-blind-spot-contract-v3",
  "status": "ACTIVE",
  "evidence_class": "xemu-prefilter-green",
  "authority_rule": "Xemu is a functional prefilter, never device acceptance authority.",
  "contract_rows": [
    {
      "id": "freezer-entry-return",
      "kind": "blind-spot",
      "reason": "The qualified Xemu has no working Freezer path (X4), so it cannot exercise Freezer entry, return, or post-Freezer restoration.",
      "device_mandatory": true,
      "forbidden_prefilter_claims": [
        "freezer-entry-correct",
        "freezer-return-correct",
        "post-freezer-state-restored"
      ]
    },
    {
      "id": "dma-visibility-completion-timing",
      "kind": "blind-spot",
      "reason": "Xemu does not establish physical DMA visibility, completion timing, or the L10 delayed-content class.",
      "device_mandatory": true,
      "forbidden_prefilter_claims": [
        "dma-content-visible-on-completion",
        "dma-completion-timing-bounded",
        "l10-closed"
      ]
    },
    {
      "id": "fpga-core-identity",
      "kind": "blind-spot",
      "reason": "The physical acceptance core is git-03b24c6b; an emulator process is not that FPGA implementation.",
      "device_mandatory": true,
      "forbidden_prefilter_claims": [
        "tested-core-equivalent",
        "fpga-rtl-behavior-proven",
        "core-specific-defect-closed"
      ]
    },
    {
      "id": "native-latency-and-typing-feel",
      "kind": "blind-spot",
      "reason": "VM steps and host runtime do not establish native-cycle latency, collection-hitch perception, or physical typing feel.",
      "device_mandatory": true,
      "forbidden_prefilter_claims": [
        "native-single-key-latency-green",
        "gc-hitch-imperceptible",
        "typing-feel-accepted"
      ]
    },
    {
      "id": "uart-hwa-versus-physical-keyboard",
      "kind": "blind-spot",
      "reason": "UART/HWA injection enters the typed-event queue without exercising the physical keyboard matrix, debounce or physical inter-key timing; it also cannot close raster-IRQ/evaluator timing races or the v1.6 double-consumer class.",
      "device_mandatory": true,
      "valid_prefilter_claims": [
        "typed-event-queue-counter-equality",
        "typed-event-queue-order-preserved",
        "typed-event-queue-losslessness"
      ],
      "forbidden_prefilter_claims": [
        "physical-keyboard-matrix-equivalent",
        "physical-key-debounce-and-inter-key-timing-proven",
        "raster-irq-evaluator-race-closed",
        "v1.6-double-consumer-class-closed"
      ]
    },
    {
      "id": "patched-xemu-fork-identity",
      "kind": "tool-identity",
      "reason": "The qualified Drei-Patch-Fork binds BUFSEL, headless keymap transport and emulated cycle counting. The withdrawn EQ-setting patch is not equivalent; incomplete or extended patch sets fail.",
      "device_mandatory": false,
      "unpatched_xemu_is_equivalent": false,
      "required_on_every_prefilter_claim": [
        "source_commit",
        "patches",
        "patched_source_sha256",
        "binary_sha256"
      ]
    }
  ],

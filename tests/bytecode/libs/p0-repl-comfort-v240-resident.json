  "cases": [
    {
      "expect": "(1 2 3)",
      "expr": "(list 1 2 3)",
      "name": "list-rest"
    },
    {
      "expect": "nil",
      "expr": "(list)",
      "name": "list-empty"
    },
    {
      "expect": "t",
      "expr": "(funcall (function consp) '(a . b))",
      "name": "named-consp-true"
    },
    {
      "expect": "nil",
      "expr": "(funcall (function consp) nil)",
      "name": "named-consp-false"
    }

{
  "extends": "p0-stdlib-time-base.json",
  "private_key_event_modes": true,
  "sources": [
    "lib/stdlib-read-line.lisp",
    "lib/stdlib-wait.lisp"
  ],
  "functions": [
    "%frame-low",
    "%cursor-blink",
    "%rl-start",
    "%rl-kind",
    "%rl-scan",
    "%rl-close",
    "%rl-open",
    "%rl-idle",
    "%rl-clear",
    "%rl-paint",
    "%rl-wait",
    "%rl-poll",
    "%rl-render",
    "%rl-cut",
    "%rl-move",
    "%rl-put",
    "%rl-dispatch",
    "%read-line-loop",
    "%rl-session",
    "%native-prompt",
    "%native-read-line",
    "read-line",
    "%rl-screen-tail",
    "%wait-until",
    "wait"
  ],
  "tailcall_self": [
    "%rl-render",
    "%wait-until"
  ],
  "allow_omitted_defuns": [
    {
      "name": "screen-write-string",
      "reason": "excluded from the canonical Workbench product; screen-bulk-p pins the supported fallback path"
    },
    {
      "name": "compile-file",
      "reason": "excluded from the compile-string Workbench profile"
    },
    {
      "name": "fasl-emit-scratch",
      "reason": "excluded from the compile-string Workbench profile"
    },
    {
      "name": "%ide-line-net-depth",
      "reason": "IDE-only indentation helper; this resident profile owns only the shared matcher objects from lib/sexp-depth.lisp"
    }
  ],
  "cases": [
    {
      "name": "read-line-empty",
      "expr": "(read-line)",
      "expect": "\"\"",
      "key_events": [13],
      "expect_key_events_remaining": 0,
      "expect_output_codes": [10],
      "expect_screen_rows": {"24": "        "},
      "expect_io_min": {"key_event": 1, "write_char": 1, "screen_put_char": 80}
    },
    {
      "name": "read-line-echo",
      "expr": "(read-line)",
      "expect": "\"abc\"",
      "key_events": [97, 98, 99, 13],
      "expect_key_events_remaining": 0,
      "expect_output_codes": [10],
      "expect_screen_rows": {"24": "abc     "},
      "expect_io_min": {"key_event": 4, "write_char": 1, "screen_put_char": 83}
    },
    {
      "name": "read-line-del-edit",
      "expr": "(read-line)",
      "expect": "\"ac\"",
      "key_events": [97, 98, 20, 99, 13],
      "expect_key_events_remaining": 0,
      "expect_output_codes": [10],
      "expect_screen_rows": {"24": "ac      "},
      "expect_io_min": {"key_event": 5, "write_char": 1, "screen_put_char": 84}
    },
    {
      "name": "read-line-delete-legacy-127",
      "expr": "(read-line)",
      "expect": "\"ac\"",
      "key_events": [97, 98, 127, 99, 13],
      "expect_key_events_remaining": 0,
      "expect_output_codes": [10],
      "expect_screen_rows": {"24": "ac      "}
    },
    {
      "name": "read-line-insert-middle-cursor-left",

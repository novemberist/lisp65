      "expect_key_events_remaining": 0,
      "expect_output_codes": [10],
      "expect_screen_rows": {"24": "xabcy   "}
    },
    {
      "name": "read-line-delete-forward",
      "expr": "(read-line)",
      "expect": "\"ac\"",
      "key_events": [97, 98, 99, 2, 2, 4, 13],
      "expect_key_events_remaining": 0,
      "expect_output_codes": [10],
      "expect_screen_rows": {"24": "ac      "}
    },
    {
      "name": "read-line-boundary-noops",
      "expr": "(read-line)",
      "expect": "\"a\"",
      "key_events": [157, 2, 20, 4, 97, 29, 6, 4, 13],
      "expect_key_events_remaining": 0,
      "expect_output_codes": [10],
      "expect_screen_rows": {"24": "a       "}
    },
    {
      "name": "read-line-ignore-control",
      "expr": "(read-line)",
      "expect": "\"a\"",

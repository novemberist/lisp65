      "expect_key_events_remaining": 0,
      "expect_output_codes": [10],
      "expect_screen_rows": {"24": "abc     "}
    },
    {
      "name": "read-line-insert-middle-control-b",
      "expr": "(read-line)",
      "expect": "\"abc\"",
      "key_events": [97, 99, 2, 98, 13],
      "expect_key_events_remaining": 0,
      "expect_output_codes": [10],
      "expect_screen_rows": {"24": "abc     "}
    },
    {
      "name": "read-line-control-f-right",
      "expr": "(read-line)",
      "expect": "\"acb\"",
      "key_events": [97, 99, 2, 6, 98, 13],
      "expect_key_events_remaining": 0,
      "expect_output_codes": [10],
      "expect_screen_rows": {"24": "acb     "}
    },
    {
      "name": "read-line-line-start-end",
      "expr": "(read-line)",

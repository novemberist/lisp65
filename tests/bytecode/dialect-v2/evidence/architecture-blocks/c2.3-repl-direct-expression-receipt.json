    "priced_candidates": [
      {
        "candidate": "reuse the legacy transient overlay",
        "reason": "compile-time-exclusive non-C2 implementation; restoring it would reintroduce the rejected dual decoder/address domain",
        "result": "rejected"
      },
      {
        "candidate": "mutable reusable C2 execution slot",
        "reason": "requires a new address, literal-root, generation and publication contract; no such owned lane exists",
        "result": "out-of-scope architecture"
      },
      {
        "candidate": "skip append or rollback for compiled expressions",
        "reason": "weakens the immutable-code and rollback contracts which are explicit Phase-C walls",
        "result": "rejected"
      },
      {
        "candidate": "batch independent interactive forms",
        "reason": "changes prompt/RETURN semantics and cannot reduce the first form's 60/62-frame response",
        "result": "not a single-form latency lever"
      }
    ],
    "release_edge": "still red for ceremony forms: sub-0.5-second response requires a separately owned transient-execution architecture, not a local edit"

    {
      "id": "native-residency-refinement",
      "status": "accepted-by-owner",
      "detail": "The plan literally requested resident native primitives. The measured candidate keeps only the 46-byte transport facade resident and stores the checked operations in reusable Bank-3 runtime-overlay slices that execute in the established Bank-0 VMA. This is EXT-neutral and link-safe, but it is a deliberate refinement of the stated layout."
    },
    {
      "id": "per-call-overlay-cost",
      "status": "carried-into-mandatory-C1-gate",
      "detail": "No performance claim is made for byte-at-a-time buffer-set! calls. C1 must not route every emitted compiler byte through a fresh overlay transport without a measured or batched seam."
    },
    {
      "id": "buffer-printer-syntax",
      "status": "withdrawal-accepted-with-wave-seal-documentation-duty",
      "detail": "A dedicated opaque printer representation was probed and rejected by the pinned overlay-VMA gate. No bytes from that probe remain. The existing generic diagnostic output is not claimed as stable; accept the limitation explicitly or fund it after C1 creates structural headroom."
    },
    {
      "id": "shelf-format-version",
      "status": "accepted-pre-wave-seal-only",
      "detail": "Adding the fourth shelf record requires L65S-v2 with a 160-byte payload prefix. The format is reset-persistent, power-volatile and product-bound; the decoder rejects v1 rather than creating a tolerant format gray zone."
    }
  ],

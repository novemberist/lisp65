diff --git a/src/tools/m65common.c b/src/tools/m65common.c
index 5c585fc..929730e 100644
--- a/src/tools/m65common.c
+++ b/src/tools/m65common.c
@@ -600,6 +600,8 @@ int stuff_keybuffer(char *s)
   int buffer_addr = 0x277;
   int buffer_len_addr = 0xc6, i;
   char cmd[1024], *pos;
+  unsigned char buffer_len;
+  long long drain_deadline;
 
   if (saw_c65_mode) {
     buffer_addr = 0x2b0;
@@ -618,7 +620,7 @@ int stuff_keybuffer(char *s)
 
   snprintf(cmd, 1024, "s%x 0\r", buffer_len_addr);
   slow_write(fd, cmd, strlen(cmd));
-  usleep(25000);
+  usleep(20000);
 
   // only use 9 of the 10 chars in the keybuffer
   // using all 10 makes weird chars on the 1st call
@@ -632,8 +634,30 @@ int stuff_keybuffer(char *s)
     log_debug("stuff_keybuffer: '%s' %d", cmd, i);
     snprintf(cmd + 5 + i * 3, 40, "\rs%x %d\r", buffer_len_addr, i);
     slow_write(fd, cmd, strlen(cmd));
-    if (i == MAX_KEYBUFFER_CHARS)
-      usleep(25000);
+
+    /*
+      Do not overwrite this chunk until the KERNAL has consumed it.  The old
+      fixed 25ms delay was shorter than a busy BASIC input cycle on real
+      hardware.  In that case the next chunk replaced the first nine bytes;
+      for example "REM M65 INJECTING ..." became "NJECTING ..." and BASIC
+      reported a syntax error.
+
+      Reading the length byte gives us the actual producer/consumer handoff.
+      Leave a complete frame between observations so the running KERNAL gets
+      CPU time, and fail instead of silently overwriting an undrained chunk.
+    */
+    drain_deadline = gettime_us() + 2000000;
+    do {
+      usleep(20000);
+      buffer_len = 0xff;
+      fetch_ram(buffer_len_addr, 1, &buffer_len);
+      if (!buffer_len)
+        break;
+    } while (gettime_us() < drain_deadline);
+    if (buffer_len) {
+      log_error("key buffer at $%04X did not drain (remaining length $%02X)", buffer_addr, buffer_len);
+      return -1;
+    }
     pos = pos + i;
   }
   return 0;
